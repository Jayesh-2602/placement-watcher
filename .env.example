# ──────────────────────────────────────────────
# Placement Portal Watcher — Environment Config
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Portal ────────────────────────────────────
PORTAL_MESSAGES_URL=https://campus.placements.iitb.ac.in/blog/placement/

# ── Telegram ──────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Add the bot to your friends group
# 3. Get chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# ── Email (Gmail SMTP) ───────────────────────
# Use a Gmail App Password (NOT your regular password).
# Google Account → Security → 2FA → App passwords → create one.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
EMAIL_RECIPIENTS=friend1@gmail.com,friend2@gmail.com,friend3@gmail.com

# ── Healthchecks.io ──────────────────────────
# Create a free check at https://healthchecks.io → copy ping URL
HEALTHCHECK_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Polling ──────────────────────────────────
POLL_INTERVAL_SECONDS=300
